{
  "name": "micro-js",
  "version": "0.2.4",
  "type": "module",
  "main": "src/index.js",
  "homepage": "https://github.com/mcbrumagin/micro-js",
  "description": "A lightweight, zero-dependency microservices framework for Node.js with built-in service discovery, pub/sub messaging, HTTP routing, and load balancing.",
  "keywords": [
    "microservices",
    "service discovery",
    "pub/sub",
    "HTTP routing",
    "load balancing"
  ],
  "exports": {
    ".": "./src/index.js",
    "./create-service": "./src/micro-core/create-service.js",
    "./create-route": "./src/micro-core/create-route.js",
    "./call-service": "./src/micro-core/call-service.js",
    "./registry-server": "./src/micro-core/registry-server.js",
    "./env-config": "./src/micro-core/env-config.js",
    "./http-error": "./src/http-primitives/http-error.js",
    "./logger": "./src/utils/logger.js",
    "./cache-service": "./src/micro-services/cache-service.js",
    "./pubsub-service": "./src/micro-services/pubsub-service.js",
    "./auth-service": "./src/micro-services/auth-service.js",
    "./static-file-service": "./src/micro-services/static-file-service.js",
    "./file-upload-service": "./src/micro-services/file-upload-service/file-upload-service.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node test/run-all-cases.js"
  },
  "files": [
    "src",
    "micro.cjs",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "devDependencies": {
    "form-data": "^4.0.4"
  }
}
